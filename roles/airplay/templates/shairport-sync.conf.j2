// Managed by airplay_wyse Ansible. Do not edit by hand — changes are overwritten.
general = {
  name = "{{ airplay_name | airplay_libconfig }}";
  mdns_backend = "avahi";
  interpolation = "soxr";
{% if airplay_device_id | string | length > 0 %}
  airplay_device_id = {{ airplay_device_id | airplay_device_id }};
{% endif %}
{% if airplay_metadata_enabled | bool %}
  dbus_service_bus = "system";
{% endif %}
};

sessioncontrol = {
  session_timeout = {{ airplay_session_timeout | int }};
};

alsa = {
  output_device = "{{ airplay_alsa_prefix }}:CARD={{ airplay_alsa_card }},DEV={{ airplay_alsa_device | int }}";
  disable_standby_mode = "{{ airplay_alsa_disable_standby }}";
{% if shairport_major | string == "5" %}
  output_format = "{{ airplay_output_format | airplay_libconfig }}";
{% endif %}
{% if airplay_output_rate | int > 0 %}
  output_rate = {{ airplay_output_rate | int }};
{% endif %}
};
{% if airplay_metadata_enabled | bool %}

metadata = {
  enabled = "yes";
  include_cover_art = "yes";
  pipe_name = "{{ airplay_metadata_pipe }}";
};
{% endif %}
